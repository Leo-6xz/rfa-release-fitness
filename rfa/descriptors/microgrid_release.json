{
  "name": "microgrid_release",
  "adapter": "folder_per_stratum",
  "root": "C:/research/mgxrl/Dataset",
  "strata": ["Normal", "Additive", "Ramp", "SlowRamp", "Sinusoid", "Stealth", "DoS"],
  "null_stratum": "Normal",
